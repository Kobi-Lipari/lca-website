*.njsproj
*.ntvs*
*.sln
*.suo
*.tsbuildinfo
.DS_Store
.env
.env.*
.env.local
# The template is the one env file that must be committed — without this
# exception `.env.*` above silently swallows it, which is why the README
# referred to a file that was not in the repo.
!.env.example
.wrangler/
audit-orphans.mjs
dist/
node_modules/
prod-schema.txt
scripts/launch-emails-sent.json
scripts/lca-import.tsv
tsconfig.app.tsbuildinfo
scripts/provision.sql
scripts/members.tsv
.dev.vars
backup-*.sql

# The accessibility tests (npm run test:a11y): the two builds, the local
# database they run on, and Playwright's results and report. .dev.vars.a11y
# is committed on purpose: it holds fake values only.
dist-a11y-on/
dist-a11y-off/
.wrangler/a11y/
test-results/
playwright-report/

# Claude Code keeps per-machine state here (settings.local.json, session
# scratch). launch.json is the shared dev-server config and is meant to be
# committed, so it is excepted rather than the whole directory ignored.
.claude/*
!.claude/launch.json
!.claude/settings.json
!.claude/agents/
!.claude/workflows/

# Database dumps
*-backup-*.sql
lca-db-backup-*.sql

# The SQLite file drizzle-kit introspects, rebuilt from migrations/ by
# scripts/db/build-local-sqlite.ts.
.drizzle/
