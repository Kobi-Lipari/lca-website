name: Test Suite

on:
  workflow_dispatch:        # the "Run workflow" button — your "when I ask"
  pull_request:
    branches: [dev, main]
    paths:
      - 'functions/**'
      - 'migrations/**'
      - 'src/lib/api.ts'
      - 'test/**'
      - 'vitest*.config.ts'

jobs:
  tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
      - run: npm ci
      - name: Typecheck functions
        run: npm run typecheck:functions
      - name: Unit tests (pairing engine + route audit)
        run: npm test
      - name: Integration tests (Workers runtime)
        run: npm run test:integration