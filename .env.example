# Copy to .env.local and fill in. Gitignored — never commit the real file.
#
# These are read by Vite and inlined into the frontend bundle at BUILD time,
# so they are visible to anyone who views the site. Only ever put publishable
# values here. Server-side secrets belong in .dev.vars (local) or Cloudflare's
# Variables and Secrets (production).
#
# Because they are baked in at build time, changing any of these means
# rebuilding — reloading the page is not enough.

# Supabase project URL and publishable (anon) key.
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Browser key for the clubs map. Restrict it by HTTP referrer in the Google
# Cloud console — an unrestricted browser key is billable by anyone who finds it.
VITE_GOOGLE_MAPS_API_KEY=your-maps-browser-key
