# Copy to .env.local and fill in. Gitignored — never commit the real file.
#
# These are read by Vite and inlined into the frontend bundle at BUILD time,
# so they are visible to anyone who views the site. Only ever put publishable
# values here. Server-side secrets belong in .dev.vars (local) or Cloudflare's
# Variables and Secrets (production).
#
# Because they are baked in at build time, changing any of these means
# rebuilding — reloading the page is not enough.

# Supabase project URL and publishable (anon) key.
# Supabase dashboard → Project Settings → API
# Only used to label the email preview in the admin mass-email tool.
VITE_SITE_URL=https://www.louisianachess.org
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Browser key for the clubs map. Restrict it by HTTP referrer in the Google
# Cloud console — an unrestricted browser key is billable by anyone who finds it.
VITE_GOOGLE_MAPS_API_KEY=your-maps-browser-key

# The spam check's site key, which the public forms' widget reads. Its
# secret, TURNSTILE_SECRET_KEY below, is the server's. Left empty, a form
# says the check didn't load; the provider's documentation lists test keys
# for a computer of your own.
VITE_TURNSTILE_SITE_KEY=

# Server-side secrets, named here so they are known, never given a value in
# this file: they are set in .dev.vars (local) or in Cloudflare's Variables
# and Secrets (production and Preview), and Vite never reads them.
# SIGNING_SECRET signs and seals the expiring tokens in links
# (functions/utils/tokens.ts), 32 random bytes or more; SIGNING_SECRET_PREVIOUS
# holds the one before it, only while it is being changed.
# SIGNING_SECRET=
# SIGNING_SECRET_PREVIOUS=
# TURNSTILE_SECRET_KEY is the spam check's secret (functions/utils/spamCheck.ts);
# without it every form that checks refuses in words.
# TURNSTILE_SECRET_KEY=
